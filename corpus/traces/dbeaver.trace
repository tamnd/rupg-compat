1 F Query "CREATE SCHEMA compat_dbeaver;"
1 B CommandComplete "CREATE SCHEMA"
1 B ReadyForQuery I
1 F Query "CREATE SEQUENCE compat_dbeaver.item_ids;"
1 B CommandComplete "CREATE SEQUENCE"
1 B ReadyForQuery I
1 F Query "CREATE TABLE compat_dbeaver.items (id int4 PRIMARY KEY DEFAULT nextval('compat_dbeaver.item_ids'), name text NOT NULL, price numeric(10, 2) NOT NULL CHECK (price >= 0));"
1 B CommandComplete "CREATE TABLE"
1 B ReadyForQuery I
1 F Query "CREATE UNIQUE INDEX items_lower_name ON compat_dbeaver.items (lower(name));"
1 B CommandComplete "CREATE INDEX"
1 B ReadyForQuery I
1 F Query "CREATE TABLE compat_dbeaver.orders (id int4 PRIMARY KEY, item_id int4 NOT NULL REFERENCES compat_dbeaver.items, qty int4 NOT NULL);"
1 B CommandComplete "CREATE TABLE"
1 B ReadyForQuery I
1 F Query "CREATE VIEW compat_dbeaver.item_totals AS SELECT i.id, i.name, coalesce(sum(o.qty), 0) AS qty FROM compat_dbeaver.items i LEFT JOIN compat_dbeaver.orders o ON o.item_id = i.id GROUP BY i.id, i.name;"
1 B CommandComplete "CREATE VIEW"
1 B ReadyForQuery I
1 F Query "COMMENT ON TABLE compat_dbeaver.items IS 'The items for sale';"
1 B CommandComplete "COMMENT"
1 B ReadyForQuery I
1 F Query "COMMENT ON COLUMN compat_dbeaver.items.name IS 'The name of the item';"
1 B CommandComplete "COMMENT"
1 B ReadyForQuery I
1 F Query "INSERT INTO compat_dbeaver.items (name, price) SELECT 'item ' || i, i * 1.5 FROM generate_series(1, 250) AS i;"
1 B CommandComplete "INSERT 0 250"
1 B ReadyForQuery I
1 F Query "INSERT INTO compat_dbeaver.orders SELECT i, i % 250 + 1, i % 4 + 1 FROM generate_series(1, 60) AS i;"
1 B CommandComplete "INSERT 0 60"
1 B ReadyForQuery I
1 F Terminate
1 F End
1 B End
