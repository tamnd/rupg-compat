5 F Query "SELECT pol.oid, pol.tableoid, pol.polrelid, pol.polname, pol.polcmd, pol.polpermissive, CASE WHEN pol.polroles = '{0}' THEN NULL ELSE    pg_catalog.array_to_string(ARRAY(SELECT pg_catalog.quote_ident(rolname) from pg_catalog.pg_roles WHERE oid = ANY(pol.polroles)), ', ') END AS polroles, pg_catalog.pg_get_expr(pol.polqual, pol.polrelid) AS polqual, pg_catalog.pg_get_expr(pol.polwithcheck, pol.polrelid) AS polwithcheck FROM unnest('{251332,251340}'::pg_catalog.oid[]) AS src(tbloid)\nJOIN pg_catalog.pg_policy pol ON (src.tbloid = pol.polrelid)"
5 B RowDescription [("oid" 3256 1 26 4 -1 0) ("tableoid" 3256 -6 26 4 -1 0) ("polrelid" 3256 3 26 4 -1 0) ("polname" 3256 2 19 64 -1 0) ("polcmd" 3256 4 18 1 -1 0) ("polpermissive" 3256 5 16 1 -1 0) ("polroles" 0 0 25 -1 -1 0) ("polqual" 0 0 25 -1 -1 0) ("polwithcheck" 0 0 25 -1 -1 0)]
5 B CommandComplete "SELECT 0"
