5 F Query "SELECT tableoid, oid, lanname, lanpltrusted, lanplcallfoid, laninline, lanvalidator, lanacl, acldefault('l', lanowner) AS acldefault, lanowner FROM pg_language WHERE lanispl ORDER BY oid"
5 B RowDescription [("tableoid" 2612 -6 26 4 -1 0) ("oid" 2612 1 26 4 -1 0) ("lanname" 2612 2 19 64 -1 0) ("lanpltrusted" 2612 5 16 1 -1 0) ("lanplcallfoid" 2612 6 26 4 -1 0) ("laninline" 2612 7 26 4 -1 0) ("lanvalidator" 2612 8 26 4 -1 0) ("lanacl" 2612 9 1034 -1 -1 0) ("acldefault" 0 0 1034 -1 -1 0) ("lanowner" 2612 3 26 4 -1 0)]
