5 F Query "SELECT s.tableoid, s.oid, s.subname,\n s.subowner,\n s.subconninfo, s.subslotname, s.subsynccommit,\n s.subpublications,\n s.subbinary,\n s.substream,\n s.subtwophasestate,\n s.subdisableonerr,\n s.subpasswordrequired,\n s.subrunasowner,\n s.suborigin,\n NULL AS suboriginremotelsn,\n false AS subenabled,\n s.subfailover,\n s.subretaindeadtuples,\n s.submaxretention,\n s.subwalrcvtimeout,\n fs.srvname AS subservername\nFROM pg_subscription s\nLEFT JOIN pg_catalog.pg_foreign_server fs \n    ON fs.oid = s.subserver \nWHERE s.subdbid = (SELECT oid FROM pg_database\n                   WHERE datname = current_database())"
