rcerlspolicy" 1259 25 16 1 -1 0) ("hastoasttable" 0 0 16 1 -1 0) ("seclabels" 0 0 1009 -1 -1 0) ("is_sys_table" 0 0 16 1 -1 0) ("partition_scheme" 0 0 25 -1 -1 0)]
