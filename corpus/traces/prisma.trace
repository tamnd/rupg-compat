2 F Query "\n\n-- CreateTable\nCREATE TABLE \"compat_items\" (\n    \"id\" SERIAL NOT NULL,\n    \"name\" TEXT NOT NULL,\n    \"price\" DECIMAL(10,2),\n    \"mood\" \"compat_mood\" NOT NULL DEFAULT 'ok',\n    \"added\" TIMESTAMPTZ(6),\n    \"tags\" TEXT[],\n    \"extra\" JSONB,\n\n    CONSTRAINT \"compat_items_pkey\" PRIMARY KEY (\"id\")\n);"
2 B CommandComplete "CREATE TABLE"
2 B ReadyForQuery I
