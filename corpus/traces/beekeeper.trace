1 F Query "INSERT INTO compat_beekeeper.compat_orders (id, item_id, qty) SELECT i, i % 30 + 1, i % 4 + 1 FROM generate_series(1, 60) AS i;"
1 B CommandComplete "INSERT 0 60"
