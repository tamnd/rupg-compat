1 F Query "CREATE TABLE compat_beekeeper.compat_orders (id int4 PRIMARY KEY, code int8 NOT NULL DEFAULT nextval('compat_beekeeper.compat_orders_code_seq'), item_id int4 NOT NULL REFERENCES compat_beekeeper.compat_items ON DELETE CASCADE, qty int4 NOT NULL CONSTRAINT compat_orders_qty_check CHECK (qty > 0));"
1 B CommandComplete "CREATE TABLE"
1 B ReadyForQuery I
1 F Query "CREATE UNIQUE INDEX compat_orders_code_key ON compat_beekeeper.compat_orders (code);"
1 B CommandComplete "CREATE INDEX"
1 B ReadyForQuery I
1 F Query "CREATE VIEW compat_beekeeper.compat_item_totals AS SELECT i.id, i.name, sum(o.qty) AS qty FROM compat_beekeeper.compat_items AS i JOIN compat_beekeeper.compat_orders AS o ON o.item_id = i.id GROUP BY i.id, i.name;"
1 B CommandComplete "CREATE VIEW"
1 B ReadyForQuery I
1 F Query "CREATE FUNCTION compat_beekeeper.compat_item_qty(p_item int4) RETURNS int8 LANGUAGE sql STABLE AS $$ SELECT sum(qty) FROM compat_beekeeper.compat_orders WHERE item_id = p_item $$;"
1 B CommandComplete "CREATE FUNCTION"
1 B ReadyForQuery I
1 F Query "COMMENT ON TABLE compat_beekeeper.compat_orders IS 'The orders of the Beekeeper Studio scenario.';"
1 B CommandComplete "COMMENT"
