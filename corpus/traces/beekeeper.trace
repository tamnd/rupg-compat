1 F Query "INSERT INTO compat_beekeeper.compat_items SELECT i, 'item ' || i, i * 1.5, '2026-01-02 03:00:00+00'::timestamptz + i * interval '1 hour' FROM generate_series(1, 30) AS i;"
1 B CommandComplete "INSERT 0 30"
