<Project Sdk="Microsoft.NET.Sdk">
  <!-- The EF Core scenario. dotnet.sh restores the packages from packages.lock.json. The Design package lets the dotnet-ef tool of .config/dotnet-tools.json read the model. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- `dotnet ef dbcontext scaffold` writes the code that it reads from the database here. It is output, not part of the program. -->
    <Compile Remove="scaffold/**" />
  </ItemGroup>
</Project>
