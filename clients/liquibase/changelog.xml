<?xml version="1.0" encoding="UTF-8"?>
<!-- The changes of the Liquibase scenario. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="1" author="compat">
    <createTable tableName="compat_items">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true"/>
      </column>
      <column name="name" type="text">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="price" type="numeric(10, 2)"/>
    </createTable>
    <insert tableName="compat_items">
      <column name="name" value="one"/>
      <column name="price" valueNumeric="1.50"/>
    </insert>
  </changeSet>
  <changeSet id="2" author="compat">
    <createTable tableName="compat_orders">
      <column name="id" type="int" autoIncrement="true">
        <constraints primaryKey="true"/>
      </column>
      <column name="item_id" type="int">
        <constraints nullable="false" foreignKeyName="compat_orders_item" references="compat_items(id)"/>
      </column>
      <column name="qty" type="int" defaultValueNumeric="1"/>
    </createTable>
    <createIndex tableName="compat_orders" indexName="compat_orders_item_id">
      <column name="item_id"/>
    </createIndex>
  </changeSet>
  <changeSet id="3" author="compat">
    <addColumn tableName="compat_items">
      <column name="added" type="timestamptz"/>
    </addColumn>
  </changeSet>
</databaseChangeLog>
